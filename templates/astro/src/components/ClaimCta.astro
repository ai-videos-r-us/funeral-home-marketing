---
const { site, listing } = Astro.props;
const href = listing ? `/claim/?listing=${encodeURIComponent(listing.slug)}&business=${encodeURIComponent(listing.name)}` : '/claim/';
---
<aside class="cta-band">
  <div>
    <h2>{listing ? 'Is this your business?' : `Own a ${site.niche.singular} business in ${site.state.name}?`}</h2>
    <p>{listing ? 'Claiming is free. Correct your details, add photos and your opening hours.' : 'Claim your free listing to correct details, add photos and opening hours.'}</p>
  </div>
  <div><a class="btn" href={href}>{listing ? 'Claim this listing' : 'Claim your listing'}</a></div>
</aside>
